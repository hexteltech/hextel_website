# ==============================================================================
# Hextel Tech Direct Mailing System Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Resend (Recommended Server-Side Direct Mailer)
# Sign up free at https://resend.com and generate an API Key.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient inbox where incoming client leads will be delivered:
CONTACT_TO_EMAIL=hexteltech@gmail.com

# Sender email address. For local testing without a verified domain, use Resend's default:
# Once you add your custom domain to Resend DNS, change this to: "Hextel Tech <contact@yourdomain.com>"
CONTACT_FROM_EMAIL="Hextel Tech <onboarding@resend.dev>"

# Set to "true" if you want to automatically send a confirmation receipt email back to the prospect:
SEND_CLIENT_RECEIPT=false


# ------------------------------------------------------------------------------
# OPTION 2: EmailJS (Client-Side Direct Mailer)
# Sign up at https://www.emailjs.com, create a service & email template.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=user_public_key_xxxxxxx
